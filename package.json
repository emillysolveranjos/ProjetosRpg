{
  "name": "rulebear",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "Extensão nativa do Owlbear Rodeo para automatizar dano, cura, resistências e condições.",
  "author": "Zero",
  "license": "MIT",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build && node scripts/prepare-pages-manifest.mjs && node scripts/verify-pages-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@owlbear-rodeo/sdk": "3.1.0",
    "immer": "11.1.18",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
